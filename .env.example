# Settings for `orionbelt-ontology-builder` and `orionbelt-ontology-builder-mcp`.
#
# Copy this file to `.env` in the directory you start from, or to
# `~/.orionbelt_ontology_builder/.env` to apply to every start, and uncomment
# what you need. A variable set in the environment wins over the file, the
# first file over the second, and a command-line flag over all of them.
# Only ORIONBELT_* and STREAMLIT_* names are read.

# --- The app's local HTTP API (orionbelt-ontology-builder) ---------------

# Start the API with the app, as --api does.
# ORIONBELT_API=1

# Where it listens (--api-host, --api-port). Anything but 127.0.0.1 exposes
# the ontology to your network, guarded only by the token.
# ORIONBELT_API_HOST=127.0.0.1
# ORIONBELT_API_PORT=8765

# A fixed bearer token instead of a fresh one on every start. The MCP server
# uses it too, from here or from ~/.orionbelt_ontology_builder/api.json.
# ORIONBELT_API_TOKEN=

# --- The MCP server (orionbelt-ontology-builder-mcp) ---------------------

# Where the API is (--api-url), for an app in Docker or on another host. By
# default the MCP server reads it from ~/.orionbelt_ontology_builder/api.json.
# ORIONBELT_API_URL=http://127.0.0.1:8765

# Serve streamable HTTP instead of stdio (--http), and where (--host, --port).
# ORIONBELT_MCP_HTTP=1
# ORIONBELT_MCP_HOST=127.0.0.1
# ORIONBELT_MCP_PORT=8766

# --- Streamlit, for the app -----------------------------------------------

# Any Streamlit option as STREAMLIT_<SECTION>_<OPTION>, e.g. the app's port.
# STREAMLIT_SERVER_PORT=8501
